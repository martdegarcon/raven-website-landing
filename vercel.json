{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "raven-custom-saber.com"
        }
      ],
      "dest": "/robots-saber.txt"
    },
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "raven-custom-saber.com"
        }
      ],
      "dest": "/sitemap-saber.xml"
    },
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.raven-custom-saber.com"
        }
      ],
      "dest": "/robots-saber.txt"
    },
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.raven-custom-saber.com"
        }
      ],
      "dest": "/sitemap-saber.xml"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "raven-custom.com"
        }
      ],
      "dest": "/portal/index.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.raven-custom.com"
        }
      ],
      "dest": "/portal/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aegis.raven-custom.com"
        }
      ],
      "dest": "/aegis/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "studio.raven-custom.com"
        }
      ],
      "dest": "/studio/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cosplay.raven-custom.com"
        }
      ],
      "dest": "/cosplay/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ai.raven-custom.com"
        }
      ],
      "dest": "/ai/index.html"
    },
    {
      "src": "/contact",
      "dest": "/"
    }
  ]
}
